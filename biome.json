{
    "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
    "files": {
        "includes": ["**", "!**/dist", "!**/*.html"]
    },
    "assist": { "actions": { "source": { "organizeImports": "on" } } },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 88
    },
    "overrides": [
        {
            "includes": ["**/tests/**"],
            "formatter": {
                "enabled": false
            }
        }
    ]
}
